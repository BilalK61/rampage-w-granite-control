{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rampage W-Granite",
  "version": "1.0.0",
  "identifier": "com.rampage.wgranite",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rampage W-Granite",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#090a0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
